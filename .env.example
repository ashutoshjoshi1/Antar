# Copy to .env (git-ignored). All settings are optional.

# Lemonade local server. Documented default port is 13305; include /v1.
ANTAR_LEMONADE__BASE_URL=http://localhost:13305/v1
# Only if the Lemonade server was started with LEMONADE_API_KEY set:
# ANTAR_LEMONADE__API_KEY=

# Longest silence tolerated while a model generates, and while it loads (seconds).
# ANTAR_LEMONADE__GENERATION_TIMEOUT_SECONDS=300
# ANTAR_LEMONADE__LOAD_TIMEOUT_SECONDS=600

# Largest image accepted for vision inference, in bytes (default 8 MB).
# ANTAR_MAX_IMAGE_BYTES=8388608

# Disable the simulated backend (e.g. in production-like runs).
# ANTAR_ENABLE_MOCK_BACKEND=false

# Path to the YAML config file (must be set in the real environment, not .env).
# ANTAR_CONFIG_FILE=configs/antar.yaml

# Frontend: API base URL. Leave unset to use the Vite dev proxy.
# VITE_API_BASE_URL=http://localhost:8080
