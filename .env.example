# Copy to .env (git-ignored). All settings are optional.

# Lemonade local server. Documented default port is 13305; include /v1.
ANTAR_LEMONADE__BASE_URL=http://localhost:13305/v1
# Only if the Lemonade server was started with LEMONADE_API_KEY set:
# ANTAR_LEMONADE__API_KEY=

# Longest silence tolerated while a model generates, and while it loads (seconds).
# ANTAR_LEMONADE__GENERATION_TIMEOUT_SECONDS=300
# ANTAR_LEMONADE__LOAD_TIMEOUT_SECONDS=600

# Largest image accepted for vision inference, in bytes (default 8 MB).
# ANTAR_MAX_IMAGE_BYTES=8388608

# --- AMD cloud (optional) -------------------------------------------------------------
# The vLLM endpoint Antar sends cloud inference to. Use the near end of an SSH tunnel
# (scripts/cloud/start_ssh_tunnel.sh); include /v1. A non-loopback host is refused unless
# it is listed in ANTAR_CLOUD__TRUSTED_HOSTS, uses https, and has an API key.
# ANTAR_CLOUD__BASE_URL=http://127.0.0.1:18000/v1
# The key vLLM was started with (scripts/cloud/start_vllm.sh --api-key-file). Placeholder:
# ANTAR_CLOUD__API_KEY=replace-with-your-own-key
# ANTAR_CLOUD__TRUSTED_HOSTS=["gpu.example.com"]
# The container image you started, recorded in experiment reports exactly as written here:
# ANTAR_CLOUD__VLLM_IMAGE=vllm/vllm-openai-rocm:v0.34.0-rocm100

# SSH host for read-only checks (preflight, amd-smi). Uses your own ssh configuration;
# the key path is only passed to ssh and is never read or copied by Antar.
# ANTAR_AMD_CLOUD__NAME=my-amd-host
# ANTAR_AMD_CLOUD__SSH_HOST=gpu.example.com
# ANTAR_AMD_CLOUD__SSH_USER=ubuntu
# ANTAR_AMD_CLOUD__SSH_KEY_PATH=~/.ssh/id_ed25519
# ANTAR_AMD_CLOUD__GPU_POLL_INTERVAL_SECONDS=10

# Cost inputs. Antar has no billing API: these are numbers you enter, and can also be set
# on the AMD Cloud page.
# ANTAR_CLOUD_COST__HOURLY_PRICE_USD=0
# ANTAR_CLOUD_COST__CREDIT_BALANCE_USD=0
# ANTAR_CLOUD_COST__MAX_EXPERIMENT_MINUTES=30

# Disable the simulated backend (e.g. in production-like runs).
# ANTAR_ENABLE_MOCK_BACKEND=false

# Path to the YAML config file (must be set in the real environment, not .env).
# ANTAR_CONFIG_FILE=configs/antar.yaml

# Frontend: API base URL. Leave unset to use the Vite dev proxy.
# VITE_API_BASE_URL=http://localhost:8080
